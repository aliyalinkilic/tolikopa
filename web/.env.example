# Dev-only: where `npm run dev` proxies /api and /ws.
# Production is same-origin (Caddy serves the SPA and reverse-proxies the API),
# so this is NOT needed for the built app.
#
# Local backend over TLS:   https://localhost
# Prod backend for testing:  https://10.0.0.10
VITE_API_TARGET=https://localhost
