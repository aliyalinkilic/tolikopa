# Tolikopa — environment. `sudo ./setup.sh` generates this file with strong random values.
# Manual install: `cp .env.example .env`, fill in the values and put tolikopa.crt + tolikopa.key
# into deploy/tls/ (as setup.sh would create them; see docs/DEPLOYMENT.md).
# NEVER COMMIT THIS FILE WITH REAL VALUES (.env is gitignored).

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=tolikopa
POSTGRES_DB=tolikopa
POSTGRES_PASSWORD=change-me-strong-random

# ── API ─────────────────────────────────────────────────────────────────────
# Ingest token shared by the agents (it also goes into the GPO's config.json). openssl rand -hex 32
INGEST_TOKEN=change-me-random-64hex
# Session signing key. openssl rand -hex 32
JWT_SECRET=change-me-random-64hex

# Only when no administrator exists: the panel asks for this one-time code before it lets
# anyone create the first admin (setup.sh creates the admin on the console, so this is
# normally unused). Empty = the API generates a code and prints it to its log
# (docker compose logs api).
SETUP_CODE=

# The panel's DNS name and the server's IP, in this order (the certificate covers both).
SERVER_HOST="tolikopa.corp.local 10.0.0.10"
# The certificate name served to clients that send no SNI (agents connecting by IP).
DEFAULT_SNI=tolikopa.corp.local

# Publish 80/443 on one interface only (e.g. the LAN address). Empty = all interfaces.
# Note: Docker-published ports are not filtered by ufw; see docs/DEPLOYMENT.md.
BIND_ADDR=

# Offline thresholds (seconds)
OFFLINE_WARN_SEC=300
OFFLINE_CRIT_SEC=1800

# Time zone
TZ=Europe/Istanbul

# ── E-mail notifications (optional — off by default) ────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=tolikopa@example.com
ALERT_EMAIL_TO=
